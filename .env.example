# Example environment configuration for brain.
# Copy to `.env` and edit as needed. Bun auto-loads `.env` — no dotenv required.

# --- LLM (OpenAI-compatible endpoint) ---
# API key for the reasoning + evaluator models.
# Leave unset to keep the legacy "codex-oauth" placeholder (only useful with a
# local OAuth proxy that ignores the key).
OPENAI_API_KEY=sk-...

# Base URL for the OpenAI-compatible endpoint. Defaults to api.openai.com.
# To use a local Codex OAuth proxy instead, uncomment the line below:
# OPENAI_BASE_URL=http://127.0.0.1:10531/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings (Ollama-compatible endpoint) ---
# Defaults to a local Ollama install at http://localhost:11434.
OLLAMA_BASE_URL=http://localhost:11434

# --- Model selection ---
# Reasoning model used by the PFC loop.
BRAIN_MODEL=gpt-5.2
# Smaller/cheaper model used by the evaluator.
BRAIN_EVALUATOR_MODEL=gpt-5.1-codex-mini
# Embedding model served by the Ollama endpoint above (must be 768-dim).
BRAIN_EMBED_MODEL=nomic-embed-text

# --- Storage ---
# SQLite database path (libSQL URL format).
BRAIN_DB_PATH=file:brain.db

# --- Sampling ---
# Default temperature for LLM calls (0.0 - 2.0).
BRAIN_TEMPERATURE=0.3
